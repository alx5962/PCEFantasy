   70                        	
   71               000C     	SCROLL_IRQ	=	$0C			; VDC CR for VBL and RCR IRQ.
   72               00E0     	HUC_SCR_HEIGHT	=	224
   73               0144     	HUC_1ST_RCR	=	$144
   74                        	
