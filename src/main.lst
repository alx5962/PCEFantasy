  483                        		.dbg	line,	"../tools/include/hucc/hucc-old-scroll.h", 9; ; Based on the original HuC and MagicKit functions by David Michel and the
  484                        		.dbg	line,	"../tools/include/hucc/hucc-old-scroll.h", 10; ; other original HuC developers.
  485                        		.dbg	line,	"../tools/include/hucc/hucc-old-scroll.h", 11; ;
