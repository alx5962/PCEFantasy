   53                        	;
   54                        	; void __fastcall init_256x224( void );
   55                        	
   56    09:DFAD             	_init_256x224	.proc
   57                        	
   58               0800     	.BAT_SIZE	=	64 * 32
   59               0080     	.CHR_0x20	=	.BAT_SIZE / 16		; 1st tile # after the BAT.
   60               7F00     	.SAT_ADDR	=	$7F00			; SAT takes 16 tiles of VRAM.
   61                        	
   62    09:DFAD  08         			php				; Disable interrupts.
   63    09:DFAE  78         			sei
   64                        	
   65    09:DFAF  20 97 FD   			call	clear_vce		; Clear all palettes.
   66                        	
   67    09:DFB2  A9 80      			lda.l	#.CHR_0x20		; CHR # of ASCII ' '.
   68    09:DFB4  85 F8      			sta.l	<_ax
   69    09:DFB6  A9 00      			lda.h	#.CHR_0x20
   70    09:DFB8  85 F9      			sta.h	<_ax
   71                        	
   72    09:DFBA  A9 08      			lda	#>.BAT_SIZE		; Size of BAT in words.
   73    09:DFBC  85 FA      			sta	<_bl
   74                        	
   75    09:DFBE  20 8D FD   			call	clear_vram_vdc		; Clear VRAM.
   76               0000     		.if	SUPPORT_SGX
   78                        		.endif
   79                        	
   80    09:DFC1  A9 D8      			lda	#<.mode_256x224		; Disable BKG & SPR layers but
   81    09:DFC3  85 EC      			sta.l	<_bp			; enable RCR & VBLANK IRQ.
   82    09:DFC5  A9 DF      			lda	#>.mode_256x224
   83    09:DFC7  85 ED      			sta.h	<_bp
   84                        	
   85               0000     		.if	SUPPORT_SGX
   90                        		.endif
   91    09:DFC9  A0 09      	!:		ldy	#^.mode_256x224		; Set VDC 2nd, VBL allowed.
   92    09:DFCB  20 83 FD   			call	set_mode_vdc
   93                        	
   94               0000     		.if	SUPPORT_SGX
   96                        		.endif
   97    09:DFCE  2C 00 02   			bit	VDC_SR			; Purge any overdue VBL.
   98    09:DFD1  28         			plp				; Restore interrupts.
   99                        	
  100    09:DFD2  20 7A E2   			call	wait_vsync		; Wait for the next VBLANK.
  101                        	
  102                        			leave				; All done, phew!
         09:DFD5  4C EF FF   			jmp	leave_proc
