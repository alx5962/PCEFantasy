  331    08:DFD3  D0 17      			bne	.return_pos		; string1 > string2
  332    08:DFD5  50 04      			bvc	!+			; Only check for end-of-string
  333    08:DFD7  C9 00      			cmp	#0			; if the V flag is set.
  334    08:DFD9  F0 0D      			beq	.return_same
  335    08:DFDB  C8         	!:		iny
  336    08:DFDC  D0 EC      			bne	.loop
  337    08:DFDE  E6 F1      			inc.h	<_di
  338    08:DFE0  E6 ED      			inc.h	<_bp			; Limited to 8KB maximum!
  339                        	;		jsr	inc.h_bp_mpr34
  340    08:DFE2  80 E6      			bra	.loop
  341                        	
  342    08:DFE4  C6 F9      	.page:		dec.h	<_ax			; Decrement length.h 
  343    08:DFE6  10 E5      			bpl	.test			; Limit comparison to 32KB.
  344                        	;		bra	cmp_same
  345                        	
  346    08:DFE8  82         	.return_same:	clx				; Return code in Y:X, X -> A.
  347    08:DFE9  C2         			cly
  348    08:DFEA  80 09      			bra	!+
  349                        	
  350    08:DFEC  A2 01      	.return_pos:	ldx	#$01			; Return code in Y:X, X -> A.
  351    08:DFEE  C2         			cly
  352    08:DFEF  80 04      			bra	!+
  353                        	
  354    08:DFF1  A2 FF      	.return_neg:	ldx	#$FF			; Return code in Y:X, X -> A.
  355    08:DFF3  A0 FF      			ldy	#$FF
  356                        	
  357    08:DFF5  68         	!:		pla				; Restore MPR3 and MPR4.
  358    08:DFF6  53 10      			tam4
  359    08:DFF8  68         			pla
  360    08:DFF9  53 08      			tam3
  361                        	
  362                        			leave				; Return and copy X -> A.
         08:DFFB  4C EF FF   			jmp	leave_proc
