  442                        	; **************
  443                        	; 16-bytes of VDC BAT information.
  444                        	;
  445                        	; N.B. MUST be 16-bytes before the SGX versions to use PCE_VDC_OFFSET.
  446                        	;
  447                        	; N.B. Declared inside this .proc so that they can be stripped if unused.
  448                        	
  449                        	; Initialized by set_bat_vdc.
  450    F8:284D             	vdc_bat_width:	ds	1	; $20, $40, $80
  451    F8:284E             	vdc_bat_height:	ds	1	; $20, $40
  452    F8:284F             	vdc_bat_x_mask:	ds	1	; $1F, $3F, $7F
  453    F8:2850             	vdc_bat_y_mask:	ds	1	; $1F, $3F
  454    F8:2851             	vdc_bat_limit:	ds	1	; (>$03FF), (>$07FF), (>$0FFF), (>$1FFF)
  455                        	
  456                        	; From blkmap.asm just to avoid wasting .bss space with padding.
  457    F8:2852             	vdc_map_draw_w:	ds	1	; (SCR_WIDTH / 8) + 1
  458    F8:2853             	vdc_map_draw_h:	ds	1	; (SCR_HEIGHT / 8) + 1
  459    F8:2854             	vdc_map_line_w:	ds	1	; Line width of map data in tiles.
  460    F8:2855             	vdc_map_scrn_w:	ds	1	; Line width of map data in screens.
  461    F8:2856             	vdc_map_pxl_x:	ds	2	; Current top-left X in pixels.
  462    F8:2858             	vdc_map_pxl_y:	ds	2	; Current top-left Y in pixels.
  463    F8:285A             	vdc_map_option:	ds	1	; Flags to disable BAT alignment.
  464                        	
  465                        	; From hucc-old-spr.asm just to avoid wasting .bss space with padding.
  466    F8:285B             	spr_max:	ds	1
  467    F8:285C             	spr_clr:	ds	1
  468                        	
  469               0000     		.if	SUPPORT_SGX
  498                        		.endif
  499                        	
  500               CF22     			.code
  501                        	
  502                        			.endp
  503                        	
  504                        			.endprocgroup
