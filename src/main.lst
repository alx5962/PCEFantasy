  132                        	; ***************************************************************************
  133                        	; ***************************************************************************
  134                        	;
  135                        	; vbl_init_scroll
  136                        	;
  137                        	; N.B. Y of $FF is the first "set-in-vblank" region.
  138                        	;
  139                        	; Y ... $FF, $BF, $F0 for 2 regions at $00 and $C0.
  140                        	;
  141                        	; From Charles MacDonald's pcetech.txt ...
  142                        	;
  143                        	;  Raster Compare Register (RCR):
  144                        	;
  145                        	;  The range of the RCR is 263 lines, relative to the start of the active
  146                        	;  display period. (defined by VSW, VDS, and VCR) The VDC treats the first
  147                        	;  scanline of the active display period as $0040, so the valid ranges for
  148                        	;  the RCR register are $0040 to $0146.
  149                        	;
  150                        	;  For example, assume VSW=$02, VDS=$17. This positions the first line of
  151                        	;  the active display period at line 25 of the frame. An RCR value of $0040
  152                        	;  (zero) causes an interrupt at line 25, and a value of $0146 (262) causes an
  153                        	;  interrupt at line 24 of the next frame.
  154                        	;
  155                        	;  Any other RCR values that are out of range ($00-$3F, $147-$3FF) will never
  156                        	;  result in a successful line compare.
  157                        	
  158    0C:CF22             	vbl_init_scroll	.proc
  159                        	
  160    0C:CF22  82         			clx				; Active List index
  161    0C:CF23  A0 FF      			ldy	#$FF			; Scroll List index
  162                        	
  163    0C:CF25  C8         	.region_loop:	iny				; Scroll List index
  164    0C:CF26  C0 04      			cpy	#HUC_NUM_SCROLLS
  165    0C:CF28  B0 49      			bcs	.last_region
  166                        	
  167    0C:CF2A  B9 6D 28   	.next_region:	lda	scroll_crl, y		; Add all the enabled Scroll
  168    0C:CF2D  29 0C      			and	#SCROLL_IRQ		; regions to the Active list.
  169    0C:CF2F  F0 F4      			beq	.region_loop
  170                        	
  171    0C:CF31  B9 65 28   			lda	scroll_top, y		; Ignore the region if it is
  172    0C:CF34  C9 E0      			cmp	#HUC_SCR_HEIGHT		; off-screen.
  173    0C:CF36  B0 ED      			bcs	.region_loop
  174                        	
  175    0C:CF38  DA         			phx				; Preserve Active List index.
  176                        	
  177    0C:CF39  CA         	.check_unique:	dex				; Check all Active List entries
  178    0C:CF3A  30 08      			bmi	.is_unique		; to see if the top is the same.
  179    0C:CF3C  DD 87 28   			cmp	active_top, x
  180    0C:CF3F  D0 F8      			bne	.check_unique
  181                        	
  182    0C:CF41  FA         			plx				; This region has the same
  183    0C:CF42  80 E1      			bra	.region_loop		; active_top as another!
  184                        	
  185    0C:CF44  FA         	.is_unique:	plx				; Restore Active List index.
  186                        	
  187    0C:CF45  9D 87 28   			sta	active_top, x		; Copy top scanline.
  188    0C:CF48  B9 69 28   			lda	scroll_btm, y		; Copy btm scanline.
  189    0C:CF4B  9D 8C 28   			sta	active_btm, x
  190    0C:CF4E  B9 6D 28   			lda	scroll_crl, y		; Copy control bits.
  191    0C:CF51  9D 90 28   			sta	active_crl, x
  192    0C:CF54  B9 71 28   			lda	scroll_xl, y		; Copy BAT coordinates.
  193    0C:CF57  9D 94 28   			sta	active_xl, x
  194    0C:CF5A  B9 75 28   			lda	scroll_xh, y
  195    0C:CF5D  9D 98 28   			sta	active_xh, x
  196    0C:CF60  B9 79 28   			lda	scroll_yl, y
  197    0C:CF63  9D 9C 28   			sta	active_yl, x
  198    0C:CF66  B9 7D 28   			lda	scroll_yh, y
  199    0C:CF69  9D A0 28   			sta	active_yh, x
  200                        	
  201    0C:CF6C  8A         			txa				; Initialize the index.
  202    0C:CF6D  9D 82 28   			sta	active_list, x
  203                        	
  204    0C:CF70  E8         			inx
  205    0C:CF71  80 B2      			bra	.region_loop
  206                        	
  207    0C:CF73  A9 E0      	.last_region:	lda	#HUC_SCR_HEIGHT		; Terminate active list.
  208    0C:CF75  9D 87 28   			sta	active_top, x
  209                        	
  210    0C:CF78  8A         			txa				; Initialize the index.
  211    0C:CF79  9D 82 28   			sta	active_list, x
  212                        	
  213    0C:CF7C  48         			pha				; Number of active regions.
  214                        	
  215    0C:CF7D  C9 02      			cmp	#2			; No sort needed if there are
  216    0C:CF7F  90 30      			bcc	.sort_done		; less than 2 active regions.
  217                        	
  218                        			; Bubble-sort the order of indexes in the Active List.
  219                        	
  220    0C:CF81  8D 81 28   	.sort_pass:	sta	active_index		; #regions left to sort.
  221                        	
  222    0C:CF84  B8         			clv				; Reset swap flag.
  223                        	
  224    0C:CF85  A0 01      			ldy	#1
  225                        	
  226    0C:CF87  BE 81 28   	.pass_loop:	ldx	active_list - 1, y	; Index of previous.
  227    0C:CF8A  BD 87 28   			lda	active_top, x
  228                        	
  229    0C:CF8D  BE 82 28   			ldx	active_list + 0, y	; Index of current.
  230    0C:CF90  DD 87 28   			cmp	active_top, x
  231    0C:CF93  90 0C      			bcc	.no_swap
  232                        	
  233    0C:CF95  B9 81 28   			lda	active_list - 1, y	; Swap them in the list.
  234    0C:CF98  99 82 28   			sta	active_list + 0, y
  235    0C:CF9B  8A         			txa
  236    0C:CF9C  99 81 28   			sta	active_list - 1, y
  237                        	
  238    0C:CF9F  89 40      			bit	#$40			; Set V flag to signal a swap.
  239                        	
  240    0C:CFA1  C8         	.no_swap:	iny				; Reached the end of the list?
  241    0C:CFA2  CC 81 28   			cpy	active_index		; #regions left to sort.
  242    0C:CFA5  90 E0      			bcc	.pass_loop
  243    0C:CFA7  50 08      			bvc	.sort_done		; Was there a swap last pass?
  244                        	
  245    0C:CFA9  AD 81 28   			lda	active_index		; #regions left to sort.
  246    0C:CFAC  3A         			dec	a
  247    0C:CFAD  C9 02      			cmp	#2			; Is there only 1 active region
  248    0C:CFAF  B0 D0      			bcs	.sort_pass		; left to sort?
  249                        	
  250    0C:CFB1  68         	.sort_done:	pla				; Number of active regions.
  251    0C:CFB2  F0 2D      			beq	.finished		; No RCR if no active regions.
  252                        	
  253                        			; Set up the first RCR and scroll coordinates.
  254                        	
  255    0C:CFB4  AE 82 28   			ldx	active_list		; 1st region in active_list.
  256    0C:CFB7  BD 87 28   			lda	active_top, x		; Is 1st region top > line 0?
  257    0C:CFBA  F0 02      			beq	!+
  258    0C:CFBC  A9 FF      			lda	#$FF			; Start display with a gap.
  259    0C:CFBE  8D 81 28   	!:		sta	active_index		; Init RCR active_list index.
  260                        	
  261    0C:CFC1  BC 94 28   			ldy	active_xl, x		; Set VBL bg_x1 and bg_y1 from
  262    0C:CFC4  8C 0C 22   			sty.l	bg_x1			; the 1st scroll region.
  263    0C:CFC7  BC 98 28   			ldy	active_xh, x
  264    0C:CFCA  8C 0D 22   			sty.h	bg_x1
  265    0C:CFCD  BC 9C 28   			ldy	active_yl, x
  266    0C:CFD0  8C 10 22   			sty.l	bg_y1
  267    0C:CFD3  BC A0 28   			ldy	active_yh, x
  268    0C:CFD6  8C 11 22   			sty.h	bg_y1
  269                        	
  270    0C:CFD9  F7 F3      			smb7	<vdc_crl		; Ensure BURST MODE is off.
  271                        	
  272    0C:CFDB  03 06      			st0	#VDC_RCR		; 1st RCR always happens just
  273    0C:CFDD  13 44      			st1	#<HUC_1ST_RCR		; before the display starts.
  274    0C:CFDF  23 01      			st2	#>HUC_1ST_RCR
  275                        	
  276                        	.finished:	leave				; All done!
         0C:CFE1  4C EF FF   			jmp	leave_proc
  277                        	
  278                        			.endp
  279                        	
