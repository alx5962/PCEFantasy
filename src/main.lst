  197    02:DFED  9C 05 04   			stz	VCE_CTW+1		; Write 1 color value.
  198    02:DFF0  9C 04 04   			stz	VCE_CTW+0		; Set lo-byte of color.
  199    02:DFF3  9C 05 04   			stz	VCE_CTW+1		; Write 1 color value.
  200    02:DFF6  88         			dey
  201    02:DFF7  D0 F1      			bne	.loop
  202    02:DFF9  28         			plp
