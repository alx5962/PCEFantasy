  359                        	;
  360                        	; set_bat_sgx - Change the SGX BAT size and initialize variables based on it.
  361                        	; set_bat_vdc - Change the PCE BAT size and initialize variables based on it.
  362                        	;
  363                        	; Args: _al = new size (0-7).
  364                        	;
  365                        	; (VDC_MWR_32x32  >> 4) or in HuCC, SCR_SIZE_32x32.
  366                        	; (VDC_MWR_32x64  >> 4) or in HuCC, SCR_SIZE_32x64.
  367                        	; (VDC_MWR_64x32  >> 4) or in HuCC, SCR_SIZE_64x32.
  368                        	; (VDC_MWR_64x64  >> 4) or in HuCC, SCR_SIZE_64x64.
  369                        	; (VDC_MWR_128x32 >> 4) or in HuCC, SCR_SIZE_128x32.
  370                        	; (VDC_MWR_128x64 >> 4) or in HuCC, SCR_SIZE_128x64.
  371                        	;
  372                        	
  373               0000     		.if	SUPPORT_SGX
  381                        		.endif
  382                        	
  383    0C:CEBA             	set_bat_vdc	.proc
  384                        	
  385    0C:CEBA  82         			clx				; Offset to PCE VDC.
  386                        	
  387    0C:CEBB  A5 F8      	set_bat_size:	lda	<_al			; Get BAT size value.
  388    0C:CEBD  29 07      			and	#7			; Sanitize screen size value.
  389    0C:CEBF  A8         			tay
  390    0C:CEC0  0A         			asl	a			; Put it in bits 4..6.
  391    0C:CEC1  0A         			asl	a
  392    0C:CEC2  0A         			asl	a
  393    0C:CEC3  0A         			asl	a
  394    0C:CEC4  85 00      			sta	<__temp
  395                        	
  396    0C:CEC6  B9 02 CF   			lda	.width, y
  397    0C:CEC9  9D 4D 28   			sta	vdc_bat_width, x
  398    0C:CECC  3A         			dec	a
  399    0C:CECD  9D 4F 28   			sta	vdc_bat_x_mask, x
  400                        	
  401    0C:CED0  B9 0A CF   			lda	.height, y
  402    0C:CED3  9D 4E 28   			sta	vdc_bat_height, x
  403    0C:CED6  3A         			dec	a
  404    0C:CED7  9D 50 28   			sta	vdc_bat_y_mask, x
  405                        	
  406    0C:CEDA  B9 12 CF   			lda	.limit, y
  407    0C:CEDD  9D 51 28   			sta	vdc_bat_limit, x
  408                        	
  409    0C:CEE0  B9 1A CF   			lda	.increment, y		; Put the VRAM increment for a
  410    0C:CEE3  95 F4      			sta	<vdc_crh, x		; line into vdc_crh for later.
  411                        	
  412    0C:CEE5  08         			php
  413    0C:CEE6  78         			sei
  414                        	
  415    0C:CEE7  A9 09      			lda	#VDC_MWR
  416    0C:CEE9  9D 00 02   			sta	VDC_AR, x
  417                        	
  418    0C:CEEC  AD 42 22   			lda	vdc_mwr			; Get the MWR access width bits.
  419    0C:CEEF  29 8F      			and	#%10001111
  420    0C:CEF1  05 00      			ora	<__temp
  421               0000     		.if	SUPPORT_SGX
  424                        		.endif
  425    0C:CEF3  8D 42 22   			sta	vdc_mwr
  426    0C:CEF6  9D 02 02   	!:		sta	VDC_DL, x
  427                        	
  428    0C:CEF9  B5 F7      			lda	<vdc_reg, x		; Restore previous VDC_AR from
  429    0C:CEFB  9D 00 02   			sta	VDC_AR, x		; the shadow variable.
  430                        	
  431    0C:CEFE  28         			plp
  432                        	
  433                        			leave
         0C:CEFF  4C EF FF   			jmp	leave_proc
  434                        	
  435    0C:CF02  20 40 80 80	.width:		db	$20,$40,$80,$80,$20,$40,$80,$80
         0C:CF06  20 40 80 80 
  436    0C:CF0A  20 20 20 20	.height:	db	$20,$20,$20,$20,$40,$40,$40,$40
         0C:CF0E  40 40 40 40 
  437    0C:CF12  03 07 0F 0F	.limit:		db	$03,$07,$0F,$0F,$07,$0F,$1F,$1F
         0C:CF16  07 0F 1F 1F 
  438    0C:CF1A  08 10 18 18	.increment	db	$08,$10,$18,$18,$08,$10,$18,$18
         0C:CF1E  08 10 18 18 
