  704                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 19; ;
  705                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 20; ; !!! WARNING : non-standard return values !!!
  706                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 21; ;
  707                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 22; ; Strings are limited to a maximum of 255 characters (+ the terminator)!
  708                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 23; ;
  709                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 24; ; The memcpy(), strcpy() and strcat() functions do NOT return the destination
  710                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 25; ; address, and they are declared "void" to check that the value is not used.
  711                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 26; ;
  712                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 27; ; mempcpy() is provided which returns the end address instead of the starting
  713                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 28; ; address, because this is typically more useful.
  714                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 29; ;
  715                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 30; ; Please note that both memcpy() and memset() are implemented using a TII for
  716                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 31; ; speed, and so the length should be < 16 bytes if used in time-critical bits
  717                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 32; ; of code (such as when using a split screen) because they delay interrupts.
  718                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 33; ;
  719                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 34; ; strncpy() and strncat() are not provided, because strncpy() was not created
  720                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 35; ; for the purpose of avoiding string overruns, and strncat() is just a poorly
  721                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 36; ; designed function IMHO.
  722                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 37; ;
  723                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 38; ; POSIX strlcpy() and strlcat() are provided instead, but once again they are
  724                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 39; ; slightly non-standard in that the return value when there is an overflow is
  725                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 40; ; the buffer size (so that the overflow can be detected), instead of the full
  726                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 41; ; size of the destination string that was too big to fit in the buffer.
  727                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 42; ;
  728                        		.dbg	line,	"../tools/include/hucc/hucc-string.h", 43; ; ***************************************************************************
